{
  "name": "mind-agent",
  "private": true,
  "type": "module",
  "description": "Mind Agent (chat público) e Painel Admin — dois produtos, um repositório, um backend",
  "scripts": {
    "dev": "npx -y serve .",
    "dev:admin": "npm run dev --prefix admin",
    "build": "npm run build:cloudflare",
    "build:admin": "npm run build --prefix admin",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "preview:cloudflare": "node scripts/servir-cloudflare.mjs",
    "banco:inspecionar": "node scripts/alimentar-banco.mjs inspecionar",
    "banco:lacunas": "node scripts/alimentar-banco.mjs lacunas",
    "banco:aplicar": "node scripts/alimentar-banco.mjs aplicar",
    "banco:dicionario": "psql \"$DATABASE_URL\" -At -f scripts/infra/dicionario_gerar.sql > docs/DICIONARIO.md",
    "banco:contrato-objetivo": "psql \"$DATABASE_URL\" -f tests/objetivo_por_tabela_contract.sql",
    "typecheck:admin": "npm run typecheck --prefix admin",
    "test:edge": "node --test tests/*.test.mjs",
    "test:admin": "npm run test --prefix admin",
    "test:guardrail": "node tests/vendedor_guardrail_preco.mjs",
    "test:vendedor": "node tests/vendedor_summit_smoke.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "pdfkit": "0.17.2",
    "wrangler": "4.125.0"
  }
}
