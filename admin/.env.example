# Painel administrativo do Mind Agent — variáveis de ambiente
# ---------------------------------------------------------------
# Este arquivo é um MODELO. Copie para `.env.local` e preencha
# localmente. Nunca comite valores reais.
#
# REGRA DE SEGURANÇA: nada aqui pode ser credencial administrativa.
# `service_role`, secret key e chaves de Edge Function NÃO entram no
# navegador — elas ficam no backend. Qualquer variável `VITE_*` é
# embutida no bundle e é pública por definição.

# Raiz da API administrativa (Edge Functions).
# Vazio = painel roda com MockAdminDataProvider (modo demonstração).
VITE_ADMIN_API_BASE_URL=

# Projeto Supabase — usado apenas para autenticação (Supabase Auth),
# nunca para consulta administrativa direta a partir do navegador.
VITE_SUPABASE_URL=

# Chave publicável (anon/publishable). É pública por design e depende
# de RLS no banco. NUNCA usar `service_role` ou secret key aqui.
VITE_SUPABASE_PUBLISHABLE_KEY=
