# Painel administrativo do Mind Agent — variáveis de ambiente
# ---------------------------------------------------------------
# Este arquivo é um MODELO e fica sem valores, de propósito. Copie
# para `.env.local` e preencha lá — `.env.local` é ignorado pelo git.
#
# REGRA DE SEGURANÇA: nada aqui pode ser credencial administrativa.
# `service_role`, secret key e chave de Edge Function NÃO entram no
# navegador — elas ficam no backend. Qualquer variável `VITE_*` é
# embutida no bundle e é pública por definição.

# Raiz da Edge Function do modulo Home V3 (`mindagent-home`) — avisos,
# composicao no ar e trocas programadas. E funcao SEPARADA da
# administrativa: rotas novas para conteudo novo, sem editar funcao viva.
# Vazio = avisos e visualizacao continuam no banco em memoria.
VITE_HOME_API_BASE_URL=

# Raiz da API administrativa (Edge Function `mindagent-admin`).
# Vazio = painel roda inteiro com MockAdminDataProvider.
VITE_ADMIN_API_BASE_URL=

# De onde cada recurso vem. Com a URL acima preenchida:
#   mock    → tudo simulado, nem o dashboard vai à rede
#   hybrid  → dashboard real, cadastros simulados (padrão desta etapa)
#   http    → tudo na API administrativa
VITE_ADMIN_DATA_MODE=

# Projeto Supabase — usado apenas por Supabase Auth (login, sessão e
# renovação de token), nunca para consulta administrativa direta a
# partir do navegador. Vazio = painel abre sem login, em demonstração.
VITE_SUPABASE_URL=

# Chave publicável (`sb_publishable_…` ou anon). É pública por design e
# depende de RLS no banco. NUNCA usar `service_role` ou secret key aqui.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Onde o app do participante e servido, para a previa das telas na
# pagina "Visualizacao da home". Em producao painel e app dividem o
# mesmo worker (`/admin/` e `/`), entao o padrao e a raiz e a variavel
# pode ficar vazia. Em desenvolvimento o painel roda sozinho na 5174 e
# `/` e ele mesmo — sem esta variavel o quadro abriria o painel dentro
# do painel, e a previa avisa em vez de mostrar coisa errada.
# Exemplo: http://localhost:3000
VITE_APP_BASE_URL=
