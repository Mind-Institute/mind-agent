# Local agent / editor config
/.claude/

# Dependências e caches de ferramentas locais (npx serve, wrangler…)
/node_modules/
/.wrangler/

# OS / editor cruft
.DS_Store
Thumbs.db
*.log

# Saída do deploy — montada por `npm run build`
/dist-cloudflare/
/dist/

# Variáveis de ambiente reais — nunca versionar. O .gitignore de `admin/`
# já cobria as dele; a raiz não cobria nada, e é aqui que fica o token do
# operador usado por `scripts/alimentar-banco.mjs`.
.env
.env.*
!.env.example

# Snapshots e diários de escrita do `alimentar-banco.mjs`. Retrato do
# banco num instante, não fonte de verdade — o banco é a fonte.
/.banco/

# Relatórios com dado pessoal dos participantes: gerados sob demanda,
# entregues como arquivo, nunca versionados.
#
# TODO PDF, e não só `avaliacao-do-dia-*`. O nome de saída do relatório é
# argumento livre — `npm run relatorio:avaliacao -- dados.json foo.pdf`
# gera `foo.pdf`, que o padrão antigo não pegava. Nenhum PDF é versionado
# neste repositório (conferido: `git ls-files "*.pdf"` é vazio), e um
# documento com nome, e-mail e o que cada participante escreveu ficava a
# um `git add .` de entrar no histórico, de onde não se tira mais.
*.pdf
